<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2F3F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Logo Mirror Euy"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_mirror_euy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIRROR EUY"
                    android:textColor="#2DD4BF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HP ke PC Screen Mirroring"
                    android:textColor="#94B8C4"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E4A5F"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="OFFLINE"
                android:textColor="#94B8C4"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Koneksi Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#133248"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="METODE KONEKSI"
                android:textColor="#67E8F9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupConn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWifi"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="WiFi / LAN"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUsb"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kabel USB (ADB)"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvConnInfoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Masukkan IP ini di Mirror Euy PC:"
                android:textColor="#94B8C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="192.168.1.x : 8888"
                android:textColor="#2DD4BF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pengaturan Mode & Kualitas Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#133248"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE &amp; KUALITAS STREAM"
                android:textColor="#67E8F9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mode Tampilan"
                android:textColor="#E2F8F5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipModeScreen"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Layar HP"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipModeGame"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game (Low Latency)"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Resolusi"
                android:textColor="#E2F8F5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip480p"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="480p (Cepat)"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip720p"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="720p (Standar)"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip1080p"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1080p (Tajam)"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Frame Rate (FPS)"
                android:textColor="#E2F8F5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip30fps"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="30 FPS"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip60fps"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 FPS"
                    android:textColor="#E2F8F5"
                    app:chipBackgroundColor="#0D2F3F"
                    app:chipStrokeColor="#1E4A5F" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Live Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="#133248"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS REAL-TIME"
                android:textColor="#67E8F9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Siap. Tekan Mulai Mirroring untuk membuka server."
                android:textColor="#E2F8F5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="PC Terhubung: 0 | FPS: 0"
                android:textColor="#94B8C4"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action Button -->
        <Button
            android:id="@+id/btnToggleMirror"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#14B8A6"
            android:text="Mulai Mirroring"
            android:textColor="#0D2F3F"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
